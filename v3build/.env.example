# =========================================================
# SIGNALOS
# ENVIRONMENT CONFIGURATION
# =========================================================

APP_ENV=production

# ---------------------------------------------------------
# DATABASE
# ---------------------------------------------------------

DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE


# ---------------------------------------------------------
# SECURITY
# ---------------------------------------------------------

# Use a long random secret.
# Do NOT change this after OAuth tokens have been stored,
# otherwise previously encrypted credentials cannot be read.

SECRET_KEY=replace-with-a-long-random-secret


# ---------------------------------------------------------
# DEFAULT SYSTEM SETTINGS
# ---------------------------------------------------------

DEFAULT_COUNTRY=IN

AI_PROVIDER=stub

EMAIL_PROVIDER=stub

VOICE_PROVIDER=disabled

CALENDAR_PROVIDER=stub


# =========================================================
# FRONTEND
# =========================================================

# Your deployed Vercel frontend URL.

FRONTEND_URL=https://YOUR-VERCEL-DOMAIN


# =========================================================
# OAUTH
# =========================================================

# General fallback OAuth callback.

OAUTH_REDIRECT_URI=https://YOUR-RENDER-DOMAIN/oauth/callback/{provider_id}


# =========================================================
# RESEND
# =========================================================

RESEND_CLIENT_ID=

RESEND_CLIENT_SECRET=

RESEND_SCOPE=emails:send

RESEND_REDIRECT_URI=https://YOUR-RENDER-DOMAIN/oauth/callback/resend


# =========================================================
# CALENDLY
# =========================================================

CALENDLY_CLIENT_ID=

CALENDLY_CLIENT_SECRET=

CALENDLY_REDIRECT_URI=https://YOUR-RENDER-DOMAIN/oauth/callback/calendly


# =========================================================
# TWILIO
# =========================================================

TWILIO_CLIENT_ID=

TWILIO_CLIENT_SECRET=

TWILIO_AUTHORIZATION_URL=

TWILIO_REDIRECT_URI=https://YOUR-RENDER-DOMAIN/oauth/callback/twilio


# =========================================================
# GOOGLE
# =========================================================

GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=

GOOGLE_REDIRECT_URI=https://YOUR-RENDER-DOMAIN/oauth/callback/google


# =========================================================
# MICROSOFT
# =========================================================

MICROSOFT_CLIENT_ID=

MICROSOFT_CLIENT_SECRET=

MICROSOFT_REDIRECT_URI=https://YOUR-RENDER-DOMAIN/oauth/callback/microsoft


# =========================================================
# HUBSPOT
# =========================================================

HUBSPOT_CLIENT_ID=

HUBSPOT_CLIENT_SECRET=

HUBSPOT_REDIRECT_URI=https://YOUR-RENDER-DOMAIN/oauth/callback/hubspot


# =========================================================
# SLACK
# =========================================================

SLACK_CLIENT_ID=

SLACK_CLIENT_SECRET=

SLACK_REDIRECT_URI=https://YOUR-RENDER-DOMAIN/oauth/callback/slack


# =========================================================
# SALESFORCE
# =========================================================

SALESFORCE_CLIENT_ID=

SALESFORCE_CLIENT_SECRET=

SALESFORCE_REDIRECT_URI=https://YOUR-RENDER-DOMAIN/oauth/callback/salesforce


# =========================================================
# PIPEDRIVE
# =========================================================

PIPEDRIVE_CLIENT_ID=

PIPEDRIVE_CLIENT_SECRET=

PIPEDRIVE_REDIRECT_URI=https://YOUR-RENDER-DOMAIN/oauth/callback/pipedrive


# =========================================================
# ZOHO
# =========================================================

ZOHO_CLIENT_ID=

ZOHO_CLIENT_SECRET=

ZOHO_REDIRECT_URI=https://YOUR-RENDER-DOMAIN/oauth/callback/zoho


# =========================================================
# DROPBOX
# =========================================================

DROPBOX_CLIENT_ID=

DROPBOX_CLIENT_SECRET=

DROPBOX_REDIRECT_URI=https://YOUR-RENDER-DOMAIN/oauth/callback/dropbox


# =========================================================
# META / WHATSAPP
# =========================================================

META_CLIENT_ID=

META_CLIENT_SECRET=

META_AUTHORIZATION_URL=

META_TOKEN_URL=

META_REDIRECT_URI=https://YOUR-RENDER-DOMAIN/oauth/callback/whatsapp_meta
